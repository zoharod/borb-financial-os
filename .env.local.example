# Copiar a .env.local y completar con los valores del proyecto Supabase
# (Project Settings > API en supabase.com/dashboard).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo server-side (nunca exponer al cliente). Necesaria para supabase gen types,
# scripts de seed, y cualquier operación admin.
SUPABASE_SERVICE_ROLE_KEY=

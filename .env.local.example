# Copiar a .env.local y completar con los valores del proyecto Supabase
# (Project Settings > API en supabase.com/dashboard).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo server-side (nunca exponer al cliente). Necesaria para supabase gen types,
# scripts de seed, y cualquier operación admin.
SUPABASE_SERVICE_ROLE_KEY=

# API key de Resend (resend.com/api-keys). Solo server-side. Mientras no haya
# un dominio propio verificado en Resend, solo puede enviar a la dirección
# con la que te registraste ahí (modo sandbox) — ver docs/project_state.md.
RESEND_API_KEY=
